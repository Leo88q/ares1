{
  "name": "solana-potato",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/backend"
  ],
  "scripts": {
    "build:web": "yarn workspace web build",
    "build:backend": "yarn workspace backend build",
    "dev:web": "yarn workspace web dev",
    "dev:backend": "yarn workspace backend dev",
    "init-onchain": "tsx scripts/init-onchain.ts",
    "grant-skr": "tsx scripts/grant-skr.ts",
    "migrate-v2": "tsx scripts/migrate-v2.ts",
    "test": "anchor test",
    "test:unit": "cargo test -p solana_potato --lib",
    "test:guards": "node --test scripts/security-guards.test.mjs",
    "typecheck": "yarn workspace web exec tsc --noEmit && yarn workspace backend typecheck",
    "simulate": "python3 economy/simulate.py",
    "ci:local": "./scripts/ci-local.sh",
    "build": "yarn build:web && yarn build:backend",
    "test:offchain": "tsx --test tests/offchain/*.test.ts",
    "test:economy": "python3 economy/simulate.py --check",
    "check:contract": "node scripts/check-contract.mjs",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "test:migrations": "tsx scripts/test-migrations-localnet.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.95.3",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.10",
    "chai": "^4.3.10",
    "mocha": "^12.0.0",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0"
  },
  "resolutions": {
    "@solana-mobile/wallet-adapter-mobile": "2.1.5",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "2.1.5",
    "@solana-mobile/mobile-wallet-adapter-protocol": "2.1.5"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "22.22.3",
    "yarn": "1.22.22"
  }
}
