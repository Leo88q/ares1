PORT=8080
# Use a dedicated RPC (Helius / Triton / QuickNode) in production; the public endpoint returns 429 under load.
# Choose exactly one cluster. Production requires an explicit value and checks RPC genesis.
SOLANA_CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=DUUBiVvpbw5BbFLpryisvLGmBWmhVYC8tdf5xCUyEadf
# Mainnet product is the production target. Devnet is for internal QA only; there is no public pilot.
PRESALE_DEVNET_TEST_ENABLED=false
# Explicitly keep real mainnet presale writes disabled until launch approvals are complete.
PRESALE_MAINNET_LIVE_APPROVED=false
# Keypair of a DEDICATED low-privilege wallet (НЕ authority-ключ! AUDIT B4).
# roll_epoch принимает любого payer'а; ключу нужно 0.1–0.2 SOL (rent/fee ~0.0013 SOL/эпоху).
# Две допустимые формы значения:
#   1) путь к JSON-файлу (формат solana-keygen, массив из 64 чисел) —
#      docker-compose монтирует ./apps/backend/keys:ro;
#   2) inline-JSON того же массива — для платформ без файловых секретов
#      (Flux, Railway, Render, ...), где секрет передаётся только переменной.
# PAYER_KEYPAIR_JSON=[12,34,...,64-е число]
PAYER_KEYPAIR_JSON=./keys/epoch-payer.json
# Checklist item 43: exposure ceiling of the hot wallet in lamports (default 0.5 SOL).
# The payer only needs rent+fees for a few epochs; anything above it is blast radius
# for a key that lives on the server. Backend warns + alerts when exceeded.
PAYER_MAX_LAMPORTS=500000000
# Comma-separated list of allowed origins (the dApp URL). "*" only for local dev.
CORS_ORIGIN=https://your-dapp.example.com
EPOCH_ROLL_CRON=*/10 * * * *
RATE_LIMIT_PER_MINUTE=30
# Express "trust proxy" setting. REQUIRED in production (the process refuses to
# start without it): silently wrong value means either a bypassable rate limit or
# a single shared IP for every client.
#   1     — behind EXACTLY ONE reverse proxy (k8s ingress, ALB, nginx) ← usual
#   false — the API is reachable directly (no proxy in front); without this a
#           client can spoof X-Forwarded-For, bypass the per-IP rate limit and
#           forge the `ip:` actor in the game_ops audit log
# Non-production default: false (fail-closed).
TRUST_PROXY=1

# ── Optional but required before mainnet (checklist item 103) ────────────────
# Second, INDEPENDENT RPC provider (a different vendor; same-vendor backup does
# not count). In production the epoch roller refuses to sign unless the signing
# snapshot is confirmed by it — set REQUIRE_SECONDARY_RPC=0 only as a conscious,
# documented downgrade.
# RPC_URL_SECONDARY=
# REQUIRE_SECONDARY_RPC=1

# Critical alerts (epoch-roller failure ladder 3/9/27, fatal startup, data-source
# mismatch) to a JSON webhook: Slack/Discord/ntfy/generic.
# ALERT_WEBHOOK_URL=

# game_ops readiness requires the complete current migration set (0001–0013).
GAME_OPS_EXPECTED_SCHEMA_VERSION=18
# Required when enabling Colony; never run Colony APIs as the migrator/superuser.
# GAME_OPS_DB_ROLE=game_ops_writer

# ── Persistent hybrid Colony (fail-closed; not release-enabled yet) ───────────
# Keep false until migration 0010 is applied/verified, rules and SKU are approved,
# wallet/device QA and backup/restore drills pass, and release review approves the code gate.
COLONIES_ENABLED=false
# Free Starter grants: OFF by default on every cluster (no silent enabling). Blocked until
# COLONY_V1_RELEASE_READY=true AND COLONY_V1_RELEASE_APPROVED=YES.
COLONY_FREE_STARTER_ENABLED=false
# Generate at least 32 random bytes locally; never commit or share this secret.
# COLONY_SESSION_SECRET=

# ── Launch gates (fail-closed; a flag alone never opens a money path) ────────
# Every user-facing paid/reward path needs TWO variables: the flag (`true`) and
# the owner approval (`YES`). Defaults are closed, and the startup log prints
# `[launch-gate] <id>: closed — …` for each one, so an accidental opening is
# visible in the deploy journal. Values like `1`/`TRUE`/`yes` do NOT count.
#
# Mainnet core (fields, market, epoch roller, health) starts without these.
# Colonies are a separate block: the core backend no longer refuses to start
# because the Colony V1 gate is closed — only colony routes/free starter do.
#
# REWARDS_RAIL_ENABLED=true      REWARDS_RAIL_APPROVED=YES      # starter + daily
# USER_PRESALE_PAYMENTS_ENABLED=true USER_PRESALE_PAYMENTS_APPROVED=YES  # packs/presale
# USER_SKR_SLOT_PURCHASES_ENABLED=true USER_SKR_SLOT_PURCHASES_APPROVED=YES
# COLONY_V1_RELEASE_READY=true   COLONY_V1_RELEASE_APPROVED=YES # + COLONIES_ENABLED=true

# ── Rewards rail (off by default) ────────────────────────────────────────────
# Dedicated reward_signer key (solana-keygen JSON path or inline array). The rail
# stays closed until REWARDS_RAIL_ENABLED=true AND REWARDS_RAIL_APPROVED=YES, and
# on mainnet also requires NODE_ENV=production and REWARDS_MAINNET_APPROVED=true.
# REWARD_KEYPAIR_JSON=
# 0 = worker off. When set, drains game_ops.reward_intents every N seconds.
REWARD_DELIVERY_INTERVAL_SECONDS=0
# Quest pool top-up cadence in seconds (default 900). The worker runs only while
# the rail is on; it tops quest_ata up to 550 POTATO (at most once per UTC day,
# only below 100 POTATO) via grant_reward_once. Explicit 0 turns it off and logs
# a warning — a one-shot 550 POTATO pool is exhausted after a few dozen players.
# QUEST_BUDGET_INTERVAL_SECONDS=900
# Secret that signs starter-pack invites (HMAC). Required for /api/rewards/starter:
# without it the endpoint answers 503 INVITES_NOT_CONFIGURED instead of handing
# 250 POTATO to any base58 address (Sybil faucet). Generate 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Issue a code for one wallet with: yarn reward-invite <wallet>
# REWARD_INVITE_SECRET=

# ── game_ops data layer (optional, fail-closed) ──────────────────────────────
# Without GAME_OPS_DATABASE_URL the API stays read-only and the reward endpoints
# answer 503 NOT_CONFIGURED. ADMIN_API_TOKEN is required when it is enabled and
# must be >= 32 characters (short secrets are rejected at startup).
#
# With GAME_OPS_DATABASE_URL the epoch roller also takes a Postgres advisory lock
# before every roll, so several backend replicas (rolling deploy overlap, a
# platform with 2+ instances) never roll the same epoch twice. Without the DB
# there is no shared lock — run exactly one replica.
# Kept credential-free on purpose: this file is scanned by scripts/secret-scan.mjs
# and a DSN with a password in it is indistinguishable from a real leak. The
# login/password form (role + password in the userinfo part, before the host)
# is in game/docs/DB_RUNBOOK.md.
# GAME_OPS_DATABASE_URL=postgres://game_ops_app@127.0.0.1:5432/ares1
# ADMIN_API_TOKEN=
# Колонийные траты POTATO (devnet only, выключено по умолчанию; mainnet блокируется кодом).
COLONY_POTATO_SPEND_ENABLED=false
