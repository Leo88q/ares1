PORT=8080
# Use a dedicated RPC (Helius / Triton / QuickNode) in production; the public endpoint returns 429 under load.
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=48D2uN5dwrpQuCJcb8Bge1hRkJVCRcS4J1JicAoAvMha
# JSON keypair of GameConfig.authority. Mount read-only; never commit.
AUTHORITY_KEYPAIR_JSON=./keys/admin-keypair.json
TELEGRAM_BOT_TOKEN=
# Optional: channel the bot administers, e.g. @solana_potato or -1001234567890. Enables real verification of the "subscribe" quest.
TELEGRAM_CHANNEL_ID=
# Comma-separated list of allowed origins (the Mini App URL). "*" only for local dev.
CORS_ORIGIN=https://your-mini-app.example.com
# Per-user per-day cap and per-claim cap, in micro POTATO (1 POTATO = 1_000_000)
DAILY_USER_REWARD_CAP_MICRO=500000000
MAX_SINGLE_REWARD_MICRO=200000000
EPOCH_ROLL_CRON=*/10 * * * *
RATE_LIMIT_PER_MINUTE=30
DATA_DIR=data
