# All VITE_* values are public in the browser bundle. Never put private RPC/admin credentials here.
VITE_SOLANA_CLUSTER=devnet
# Public fallback for development. Restrict a browser RPC key at the provider, or use a protected proxy.
VITE_RPC_URL=https://api.devnet.solana.com
VITE_PROGRAM_ID=DUUBiVvpbw5BbFLpryisvLGmBWmhVYC8tdf5xCUyEadf
# Default ON: the program closes legacy V1 listings (create_sell_order -> LegacyMarketClosed),
# so the V2 screen is the only place where a new order can be created. Set to false only as an
# emergency UI rollback — it does not reopen V1 writes; the market tier thresholds still need
# owner approval before a V2 release on a new cluster.
VITE_MARKET_V2_ENABLED=true
# SOL presale purchase (`buy_field_sol`): the only cold-start path for a wallet
# that has no POTATO. OFF by default — enable it together with an OPEN presale run
# and just before the launch announcement. When off, the UI offers no SOL purchase
# button and explains where the first field comes from.
VITE_PRESALE_SOL_ENABLED=false
# Optional public HTTPS backend origin for production. Leave blank for relative /api calls;
# Vite proxies those to BACKEND_PROXY_TARGET (server-side only) during local development;
# default local backend target: http://127.0.0.1:8080 (set in the Vite process env).
# This URL is public; never place RPC credentials or server secrets here.
VITE_BACKEND_URL=
