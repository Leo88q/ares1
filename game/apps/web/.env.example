# Cluster: localnet | devnet | testnet | mainnet-beta
VITE_SOLANA_CLUSTER=devnet
# RPC endpoint. Public devnet RPC is heavily rate-limited (429) — use a Helius/Triton/QuickNode URL for anything beyond a demo.
VITE_RPC_URL=https://api.devnet.solana.com
# Deployed program (same on devnet/mainnet as long as target/deploy/solana_potato-keypair.json is reused)
VITE_PROGRAM_ID=DUUBiVvpbw5BbFLpryisvLGmBWmhVYC8tdf5xCUyEadf
# Backend that signs grant_reward (apps/backend). Leave empty to disable quests.
VITE_BACKEND_URL=https://your-backend.example.com
