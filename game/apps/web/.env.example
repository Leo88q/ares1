# All VITE_* values are public in the browser bundle. Never put private RPC/admin credentials here.
#
# Cloudflare Pages (проект ares1-play) и любой другой CI: если переменных нет
# в окружении сборки, vite.config.ts подставляет ПУБЛИЧНЫЕ devnet-значения из
# этого файла и громко предупреждает в логе сборки. Значения, заданные в
# дашборде (Settings → Environment variables) или в apps/web/.env.local,
# всегда имеют приоритет над этим фолбэком.
VITE_SOLANA_CLUSTER=devnet
# Public fallback for development. Restrict a browser RPC key at the provider, or use a protected proxy.
VITE_RPC_URL=https://api.devnet.solana.com
VITE_PROGRAM_ID=DUUBiVvpbw5BbFLpryisvLGmBWmhVYC8tdf5xCUyEadf
# Keep false until the V2 binary is deployed on this cluster and the owner approves tier thresholds.
VITE_MARKET_V2_ENABLED=false
# Optional read-only backend URL. Keep empty when no backend is deployed.
# If set, add its origin to connect-src in public/_headers, otherwise the CSP
# blocks gameops calls and the Phase 1 counter in PresaleSection.
VITE_BACKEND_URL=
# Phase 1 informational run id. Setting this only selects the status shown in
# the UI; it does not approve or open a payment run.
VITE_PRESALE_RUN=
# Landing page for the Phase 1 form. Default: https://ares1-7e1.pages.dev
VITE_LANDING_URL=
