# Публичный адрес сайта (canonical/OG) — заполняется при деплое.
VITE_SITE_URL=

# Необязательный внешний приёмник витрины ожидания (если не задан — форма скрыта).
VITE_WAITLIST_ENDPOINT=

# Куда форма Фазы 1 ходит за /api/presale. Если не задано, берётся
# относительный /api/presale: локально его проксирует vite (см. vite.config.ts),
# в проде — Cloudflare Pages Function (functions/api/[[path]].js).
# Задавать не нужно и не рекомендуется: заданный внешний origin придётся
# добавить в connect-src (public/_headers) и в CORS_ORIGIN бэкенда, иначе
# браузер заблокирует запрос раньше, чем он уйдёт.
VITE_PRESALE_API=

# id тиража Фазы 1 для баннера. Должен совпадать с PRESALE_RUN_ID при открытии
# тиража (docs/PRESALE_DELIVERY_RUNBOOK.md §1.1). По умолчанию wave1.
VITE_PRESALE_RUN=

# --- Cloudflare Pages: Settings → Environment variables (НЕ Vite) ---
# Адрес бэкенда пресейла для Pages Function-прокси: https://<бэкенд> без /api.
# Пока переменная не задана, /api/* отвечает 503 presale_api_not_configured.
PRESALE_API_ORIGIN=
