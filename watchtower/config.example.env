WATCHTOWER_EXPORTER_PORT=8790
# Required: independent >=32-character bearer credential. Never reuse admin tokens.
WATCHTOWER_EXPORTER_TOKEN=
WATCHTOWER_CLUSTER=devnet
WATCHTOWER_RPC_URL=
WATCHTOWER_RPC_FALLBACK_URL=
WATCHTOWER_DATABASE_URL=
# mock serves no fabricated metrics and is never ready for a live integration.
WATCHTOWER_EVENT_PROVIDER=mock
WATCHTOWER_ENABLE_WRITES=false
# Reserved compatibility variable; MUST remain empty. Identity belongs to Watchtower.
WATCHTOWER_PLAYER_HASH_SALT=
WATCHTOWER_RPC_TIMEOUT_MS=10000
WATCHTOWER_POLL_MS=15000
WATCHTOWER_PAGE_SIZE=50
